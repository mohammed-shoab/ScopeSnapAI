# ── Local uploads (dev storage) ──────────────────────────────────────────────
uploads/

# ── AI Model files — LARGE FILES, stored in R2, downloaded at startup ─────────
# .pkl files are small (< 7 MB) — committed to git ✓
# .pt  files are large (50–149 MB) — stored in R2, NOT in git ✗
models/*.pt
models/*.pth

# Exception: keep small model files in git
!models/*.pkl
!models/README.md


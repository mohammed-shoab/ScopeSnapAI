#!/usr/bin/env bash
# SnapAI brain-files pre-commit hook
# Enforces the mechanical rules from SnapAI_Brain_Files_Management_Plan_2026-07-05.md
# Rejects commits that violate: (1) Previously: blocks in mutable state files,
# (2) line-count caps, (3) diagnos* language in homeowner-facing files.
#
# INSTALL: from repo root, run:
#   git config core.hooksPath .githooks
# or copy this file to .git/hooks/pre-commit + chmod +x
#
# BYPASS (emergency only): git commit --no-verify

set -e
FAIL=0
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "── SnapAI pre-commit hook ──────────────────────────────────"

# ── Rule 1: no "Previously:" blocks in top 30 lines of mutable-state files ──
for f in STATUS.md; do
  filepath="$REPO_ROOT/$f"
  if [ -f "$filepath" ] && git diff --cached --name-only | grep -q "^$f\$"; then
    if head -30 "$filepath" | grep -q "^> Previously:\|^Previously:\|| Previously:"; then
      echo "✗ RULE 1 VIOLATION: '$f' has a 'Previously:' block in the top 30 lines."
      echo "  Fix: overwrite the current section — do not append 'Previously:' narrative."
      echo "  Move history to a *_HISTORY.md file if needed."
      FAIL=1
    fi
  fi
done

# For PROJECT_BRAIN.md + TECH_STACK.md — allow one "Previously:" in the "Last updated" line stamp,
# but reject anything more than that within top 30 lines
for f in PROJECT_BRAIN.md TECH_STACK.md; do
  filepath="$REPO_ROOT/$f"
  if [ -f "$filepath" ] && git diff --cached --name-only | grep -q "^$f\$"; then
    prev_count=$(head -30 "$filepath" | grep -c "Previously:" || echo 0)
    if [ "$prev_count" -gt 1 ]; then
      echo "✗ RULE 1 VIOLATION: '$f' has $prev_count 'Previously:' occurrences in top 30 lines (max 1 allowed in 'Last updated' stamp)."
      echo "  Fix: keep only one 'Previously:' in the 'Last updated' line. Move older history to ${f%.md}_HISTORY.md."
      FAIL=1
    fi
  fi
done

# ── Rule 2: line-count caps ──
declare -A CAPS
CAPS[STATUS.md]=60
CAPS[PROJECT_BRAIN.md]=500
CAPS[TECH_STACK.md]=500
CAPS[ACTIVE_TASKS.md]=300
CAPS[WORKFLOW.md]=300
CAPS[MARKET_GUIDE.md]=300

for f in "${!CAPS[@]}"; do
  filepath="$REPO_ROOT/$f"
  if [ -f "$filepath" ] && git diff --cached --name-only | grep -q "^$f\$"; then
    lines=$(wc -l < "$filepath")
    cap="${CAPS[$f]}"
    if [ "$lines" -gt "$cap" ]; then
      echo "⚠ RULE 2 WARNING: '$f' is $lines lines (cap $cap). Consider pruning + moving to ${f%.md}_HISTORY.md."
      # WARN not fail — prevents blocking legitimate reference material growth
    fi
  fi
done

# ── Rule 3: no diagnos* strings in homeowner-facing files ──
# Alfred's Principle 3 enforcement (from SnapAI_Legal_UI_Audit_v2_DEEP_2026-07-05.md)
HOMEOWNER_PATHS=(
  "scopesnap-web/app/homeowner/"
  "scopesnap-web/app/d/"
  "scopesnap-web/app/r/"
  "scopesnap-api/templates/"
)

STAGED_FILES=$(git diff --cached --name-only)
for path_prefix in "${HOMEOWNER_PATHS[@]}"; do
  echo "$STAGED_FILES" | grep "^$path_prefix" | while read -r staged_file; do
    if [ -f "$REPO_ROOT/$staged_file" ]; then
      # Grep for user-visible diagnos* — skip comments, imports, event names
      hits=$(grep -iE "diagnos(is|tic|e|ed|ing)" "$REPO_ROOT/$staged_file" 2>/dev/null | grep -v "^import\|// \|/\*\|trackEvent\|// eslint" || true)
      if [ -n "$hits" ]; then
        echo "✗ RULE 3 VIOLATION: '$staged_file' contains 'diagnos*' language in a homeowner-facing file."
        echo "  Homeowner-facing surfaces must use 'assess*'/'assessment*' language (Alfred's Principle 3, DTPA §17.42)."
        echo "  Hits:"
        echo "$hits" | sed 's/^/    /'
        FAIL=1
      fi
    fi
  done
done

# Also check services/email.py for diagnos* in homeowner-touching sections
EMAIL_PY="$REPO_ROOT/scopesnap-api/services/email.py"
if [ -f "$EMAIL_PY" ] && echo "$STAGED_FILES" | grep -q "scopesnap-api/services/email.py"; then
  if grep -iE "diagnos(is|tic|e|ed|ing)" "$EMAIL_PY" > /dev/null 2>&1; then
    echo "⚠ RULE 3 WARNING: services/email.py contains 'diagnos*' — verify none of it reaches homeowner-facing email templates."
    # WARN because internal comments are OK
  fi
fi

# ── Result ──
if [ "$FAIL" -eq 0 ]; then
  echo "✓ All pre-commit rules passed."
  exit 0
else
  echo ""
  echo "═════════════════════════════════════════════════════════════"
  echo "COMMIT REJECTED — fix the issues above or use 'git commit --no-verify' (emergency only)"
  echo "═════════════════════════════════════════════════════════════"
  exit 1
fi
